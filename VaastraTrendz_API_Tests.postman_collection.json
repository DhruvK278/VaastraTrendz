{
  "info": {
    "name": "VaastraTrendz API QA Automation",
    "description": "Postman test collection for VaastraTrendz Next.js/Express backend. Includes test coverage for Order processing, Auth middleware, and the ReAct LangGraph support agent validation schemas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "your-admin-api-key",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Orders",
      "item": [
        {
          "name": "1.1 Create Order - Valid (Happy Path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+1234567890\",\n  \"address\": \"123 Fashion St, NY\",\n  \"totalAmount\": 150,\n  \"items\": [\n    {\n      \"id\": \"prod_1\",\n      \"quantity\": 2,\n      \"price\": 75\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has success message and order details', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Order placed successfully');",
                  "    pm.expect(jsonData.order).to.be.an('object');",
                  "    pm.expect(jsonData.order.customerName).to.eql('John Doe');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Create Order - Invalid Input (Missing Items)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+1234567890\",\n  \"address\": \"123 Fashion St, NY\",\n  \"totalAmount\": 150,\n  \"items\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error message mentions missing required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('Missing required fields or empty cart');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Support Agent",
      "item": [
        {
          "name": "2.1 Create Ticket - Valid (Happy Path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Jane Smith\",\n  \"customer_email\": \"jane.smith@example.com\",\n  \"issue\": \"Wrong Item Received\",\n  \"issue_description\": \"I received a red shirt instead of the blue one I ordered. Please fix this.\",\n  \"order_id\": \"ORD-12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Ticket created with correct fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.customer_name).to.eql('Jane Smith');",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Create Ticket - Invalid Input (Bad Enum & Types)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"\",\n  \"customer_email\": \"not-an-email\",\n  \"issue\": \"I want a refund\",\n  \"issue_description\": \"short\",\n  \"order_id\": \"ORD-12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Validation errors returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Validation failed');",
                  "    pm.expect(jsonData.errors).to.be.an('array').that.is.not.empty;",
                  "    var errorString = JSON.stringify(jsonData.errors);",
                  "    pm.expect(errorString).to.include('customer_name');",
                  "    pm.expect(errorString).to.include('customer_email');",
                  "    pm.expect(errorString).to.include('issue');",
                  "    pm.expect(errorString).to.include('issue_description');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Chat with Agent - Valid (Happy Path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hi, I received a damaged item.\"\n    }\n  ],\n  \"customerContext\": {\n    \"name\": \"Alice Bob\",\n    \"email\": \"alice@example.com\",\n    \"orderId\": \"ORD-999\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Agent returned a reply', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.reply).to.be.a('string');",
                  "    pm.expect(jsonData).to.have.property('actions_executed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Chat with Agent - Invalid Input (Missing Messages)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [],\n  \"customerContext\": {\n    \"name\": \"Alice Bob\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Validation failed for messages', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Validation failed');",
                  "    var errorString = JSON.stringify(jsonData.errors);",
                  "    pm.expect(errorString).to.include('messages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 List Tickets - No Validation Required",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/support/list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "list"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array (even if empty)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Get Ticket by ID - No Validation Required",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/support/run/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "run",
                "123"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an object', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.7 Update Ticket - Valid & Authorized",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/update/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "update",
                "123"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"Refund\",\n  \"resolution_description\": \"Manually authorized full refund for order after reviewing case.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status updated to Manually Resolved', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('Manually Resolved');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.8 Update Ticket - Unauthorized (Missing Auth Header)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/update/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "update",
                "123"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"Refund\",\n  \"resolution_description\": \"Trying to refund without auth.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// The server might return 401 Unauthorized or 500 if key isn't set.",
                  "pm.test('Status code is 401 or 500', function () { pm.expect(pm.response.code).to.be.oneOf([401, 500]); });",
                  "pm.test('Error message present', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.9 Update Ticket - Invalid Input (Bad Resolution Enum)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/update/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "update",
                "123"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"InvalidResolution\",\n  \"resolution_description\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Validation failed due to bad enum', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Validation failed');",
                  "    var errorString = JSON.stringify(jsonData.errors);",
                  "    pm.expect(errorString).to.include('resolution');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}